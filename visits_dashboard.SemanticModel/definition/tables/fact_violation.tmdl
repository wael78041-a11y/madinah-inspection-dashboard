	partition fact_violation = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\\Users\\risk_\\Downloads\\visits_dashboard_pbip\\data\\fact_violation.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"مفتاح المخالفة", Int64.Type}, {"رقم الزيارة", type text}, {"معرف المخالفة", type text}, {"قيمة المخالفة", type number}, {"رقم بند اللائحة", type text}, {"هل المخالفة انذار", type text}, {"حالة السداد", type text}, {"رقم السداد", type text}, {"تاريخ السداد", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

