table fact_violation
	lineageTag: 4374b295-73af-4a85-b188-e329c1678d90

	/// عدد صفوف المخالفات (يرجع 0 بدل فراغ للزيارات الممتثلة) — لا تستخدم DISTINCTCOUNT على معرف المخالفة لأنه يتصادم
	measure 'عدد المخالفات' = COUNTROWS('fact_violation') + 0
		formatString: #,0
		lineageTag: 70b5dfc2-ce9c-42fe-8767-57cced9bbe63

	/// إجمالي قيم المخالفات (يرجع 0 بدل فراغ) — يُحسب على حبيبة المخالفة
	measure 'إجمالي الغرامات' = SUM('fact_violation'[قيمة المخالفة]) + 0
		formatString: #,0
		lineageTag: 5e392831-ded6-4532-9352-37199ec5c452

	/// متوسط قيمة المخالفة الواحدة
	measure 'متوسط الغرامة' = AVERAGE('fact_violation'[قيمة المخالفة])
		formatString: #,0
		lineageTag: 0184206e-cb6a-4fcd-9027-5b9844f77582

	/// قيمة الغرامات المسددة فعليًا
	measure 'الغرامات المسددة' = CALCULATE([إجمالي الغرامات], 'fact_violation'[حالة السداد] = "مسددة")
		formatString: #,0
		lineageTag: 79fd5abb-7268-4022-ab51-9a467f288ba8

	/// قيمة الغرامات المستحقة
	measure 'الغرامات غير المسددة' = CALCULATE([إجمالي الغرامات], 'fact_violation'[حالة السداد] = "لم تُسدد")
		formatString: #,0
		lineageTag: 645619da-2c59-400e-84d5-34bfc8914b2b

	/// المسددة ÷ (المسددة + غير المسددة) — تستبعد الملغاة وغير المفوترة
	measure 'نسبة التحصيل' = DIVIDE([الغرامات المسددة], [الغرامات المسددة] + [الغرامات غير المسددة])
		formatString: 0.0%
		lineageTag: 5f76030f-9608-43f7-9d7b-4cc7b61752db

	/// المخالفات المصنفة كإنذار
	measure 'عدد الإنذارات' = CALCULATE([عدد المخالفات], 'fact_violation'[هل المخالفة انذار] = "نعم")
		formatString: #,0
		lineageTag: b5bc43af-38fd-4e60-bae2-6cf6d64bcc25

	/// متوسط عدد المخالفات في الزيارة
	measure 'مخالفات لكل زيارة' = DIVIDE([عدد المخالفات], [عدد الزيارات])
		formatString: #,0.00
		lineageTag: 0f0bcbef-0700-4e2d-a80b-48012be10aeb

	/// إجمالي الغرامات في الشهر السابق
	measure 'إجمالي الغرامات ش.س' = CALCULATE([إجمالي الغرامات], DATEADD('dim_date'[التاريخ], -1, MONTH))
		formatString: #,0
		lineageTag: d1a7c671-1a18-4186-be3a-29fd8313257c

	/// نسبة التغير عن الشهر السابق
	measure 'تغير الغرامات %' =
			VAR p = [إجمالي الغرامات ش.س]
			RETURN DIVIDE([إجمالي الغرامات] - p, p)
		formatString: 0.0%
		lineageTag: bc0247d7-e886-43d5-b594-deb86b98fe07

