	partition fact_visit = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\\Users\\risk_\\Downloads\\visits_dashboard_pbip\\data\\fact_visit.csv"), [Delimiter=",", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"رقم الزيارة", type text}, {"تاريخ ووقت الاسناد", type datetime}, {"تاريخ بدء الزيارة", type datetime}, {"تاريخ انهاء الزيارة", type datetime}, {"هوية المراقب", type text}, {"رقم الرخصة", type text}, {"كود الايزيك", type text}, {"نوع الرقابة", type text}, {"نوع الزيارة", type text}, {"حالة الزيارة", type text}, {"حالة_مبسطة", type text}, {"درجة خطورة النشاط", Int64.Type}, {"درجة الامتثال", Int64.Type}, {"عدد البنود الغير ممتثلة", Int64.Type}, {"مدة الزيارة (دقيقة)", type number}, {"مدة صالحة", type text}, {"خط العرض", type number}, {"خط الطول", type number}, {"احداثي صالح", type text}, {"تاريخ الزيارة", type date}, {"ساعة_الزيارة", Int64.Type}, {"يوم_الاسبوع", type text}, {"زمن الاستجابة (ساعة)", type number}, {"مفتاح الموقع", type text}}, "en-US")
				in
