table fact_visit
	lineageTag: d418fcda-ebe6-48cb-a6b6-fa59c01fad30

	/// إجمالي عدد الزيارات الرقابية
	measure 'عدد الزيارات' = COUNTROWS('fact_visit')
		formatString: #,0
		lineageTag: fa642b14-ddf9-4b36-b20a-39247387e51d

	/// الزيارات المنتهية فعليًا
	measure 'عدد الزيارات المكتملة' = CALCULATE([عدد الزيارات], 'fact_visit'[حالة_مبسطة] = "مكتملة")
		formatString: #,0
		lineageTag: f6133670-42e1-4eb6-9ee4-603186961fcf

	/// الزيارات المكتملة ÷ إجمالي الزيارات
	measure 'نسبة الإنجاز' = DIVIDE([عدد الزيارات المكتملة], [عدد الزيارات])
		formatString: 0.0%
		lineageTag: 9c1f0cee-0c5c-4f90-b8d2-03d892c1e466

	/// عدد المنشآت الفريدة المزارة (مفتاح الرخصة)
	measure 'عدد المنشآت' = DISTINCTCOUNT('fact_visit'[رقم الرخصة])
		formatString: #,0
		lineageTag: 8b11dc95-e41d-4278-aefc-cc1c80791953

	/// عدد المراقبين النشطين
	measure 'عدد المراقبين' = DISTINCTCOUNT('fact_visit'[هوية المراقب])
		formatString: #,0
		lineageTag: 2eb71090-5706-4ba1-b987-10fbdbf478b9

	/// متوسط درجة الامتثال (0-100)
	measure 'متوسط درجة الامتثال' = AVERAGE('fact_visit'[درجة الامتثال])
		formatString: #,0.0
		lineageTag: f2da10cc-c1d9-4989-af4d-30718ead758e

	/// يستبعد تلقائيًا المدد السالبة والأطول من 24 ساعة
	measure 'متوسط مدة الزيارة (دقيقة)' = AVERAGE('fact_visit'[مدة الزيارة (دقيقة)])
		formatString: #,0.0
		lineageTag: b6cd6af4-79dc-497b-bd8e-5bf4289e1a3e

	/// من الإسناد إلى بدء الزيارة
	measure 'متوسط زمن الاستجابة (ساعة)' = AVERAGE('fact_visit'[زمن الاستجابة (ساعة)])
		formatString: #,0.0
		lineageTag: 5252418a-9f63-4a9b-be36-5f7f90e364f4

	/// زيارات بلا أي مخالفة (إجمالي الزيارات ناقص الزيارات التي لها مخالفات)
	measure 'عدد الزيارات الممتثلة' = [عدد الزيارات] - DISTINCTCOUNT('fact_violation'[رقم الزيارة])
		formatString: #,0
		lineageTag: 56b683e6-61af-4151-8631-82ac87f536b3

	/// الزيارات بلا مخالفات ÷ إجمالي الزيارات
	measure 'نسبة الامتثال' = DIVIDE([عدد الزيارات الممتثلة], [عدد الزيارات])
		formatString: 0.0%
		lineageTag: 2185b9da-a1c3-41d0-9921-bc50d9a302af

	/// متوسط عبء العمل
	measure 'زيارات لكل مراقب' = DIVIDE([عدد الزيارات], [عدد المراقبين])
		formatString: #,0.0
		lineageTag: 0349d956-63c5-44a3-8118-a8deb91aff7e

	/// عدد الزيارات في الشهر السابق
	measure 'عدد الزيارات ش.س' = CALCULATE([عدد الزيارات], DATEADD('dim_date'[التاريخ], -1, MONTH))
		formatString: #,0
		lineageTag: 5bbb83e7-8888-4b06-9af1-0b16db4d53b3

	/// نسبة التغير عن الشهر السابق
	measure 'تغير الزيارات %' =
			VAR p = [عدد الزيارات ش.س]
			RETURN DIVIDE([عدد الزيارات] - p, p)
		formatString: 0.0%
		lineageTag: a96586ff-b505-4839-b842-ad3f746d4d3b

	column 'رقم الزيارة'
		dataType: string
		lineageTag: 64b4f59c-908d-4ed4-8626-ce9665b5f7a5
		summarizeBy: none
		sourceColumn: رقم الزيارة

